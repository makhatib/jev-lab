# Copy to .env (never commit .env). All values are optional:
# you can paste keys in the app at http://localhost:8080/setup instead.

# TypeSafe Jev API key — https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Claude subscription token (run `claude setup-token` on your machine; starts with sk-ant-oat)
CLAUDE_CODE_OAUTH_TOKEN=

# Or an Anthropic API key instead of the subscription (race tab only)
ANTHROPIC_API_KEY=

# OpenAI API key — enables the "Jev vs OpenAI Decisions" tab (gpt-6-luna)
OPENAI_API_KEY=

# Local port for the app
JEV_LAB_PORT=8080
